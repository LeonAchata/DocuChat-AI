# Claude API key (https://console.anthropic.com). Required for answers.
ANTHROPIC_API_KEY=

# Storage: "memory" (local files under data/) or "postgres" (pgvector)
DOCUCHAT_STORE=memory
# DOCUCHAT_DATABASE_URL=postgresql://docuchat:docuchat@localhost:5432/docuchat

# Local ONNX models (downloaded on first run)
# DOCUCHAT_DENSE_MODEL=BAAI/bge-small-en-v1.5
# DOCUCHAT_SPARSE_MODEL=prithivida/Splade_PP_en_v1
# DOCUCHAT_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
# Multilingual documents: DOCUCHAT_DENSE_MODEL=intfloat/multilingual-e5-large
#                         DOCUCHAT_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# Retrieval
# DOCUCHAT_TOP_K=6
# DOCUCHAT_MIN_RELEVANCE=0.02
# DOCUCHAT_QUERY_EXPANSION=true
# DOCUCHAT_CONTEXTUALIZE=false   # Anthropic contextual retrieval at ingestion (extra LLM cost)

# LLM
# DOCUCHAT_MODEL=claude-opus-5-5
# DOCUCHAT_EFFORT=medium
